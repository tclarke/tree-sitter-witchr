{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "witchr",
      "camelcase": "Witchr",
      "title": "Witchr",
      "scope": "source.witchr",
      "file-types": [
        "tape",
        "witch",
        "witchr"
      ],
      "injection-regex": "^witchr$",
      "class-name": "TreeSitterWitchr"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "MIT",
    "description": "Tape file format for W.I.T.C.H. simulator",
    "authors": [
      {
        "name": "Trevor R.H. Clarke",
        "email": "retrev@csh.rit.edu"
      }
    ],
    "links": {
      "repository": "https://github.com/tclarke/tree-sitter-witchr"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}